pipeline {
  agent { label params.AGENT_LABEL }
  options {
    timestamps()
    disableConcurrentBuilds()
  }
  parameters {
    string(name: 'AGENT_LABEL', defaultValue: 'windows-tester1', description: 'Jenkins agent label to run the pipeline on')
    string(name: 'JOB_NAME', defaultValue: 'CrealityPrint_Release_Package_pipeline', description: 'Jenkins job name to download from')
    string(name: 'BUILD_ID', defaultValue: 'lastSuccessfulBuild', description: 'Jenkins build number or lastSuccessfulBuild')
    string(name: 'ARTIFACT_PATH', defaultValue: '', description: 'Artifact relativePath or filename (optional)')
    string(name: 'PLATFORM', defaultValue: 'windows', description: 'Platform label for env injection (windows/macos_x86/macos_arm64/linux)')
    booleanParam(name: 'TEST_QUALITY', defaultValue: false, description: '质量参数')
    booleanParam(name: 'TEST_STRENGTH', defaultValue: false, description: '强度参数')
    booleanParam(name: 'TEST_SUPPORT', defaultValue: false, description: '支撑参数')
    booleanParam(name: 'TEST_SPEED', defaultValue: false, description: '速度参数')
    booleanParam(name: 'TEST_PROCESS_FILAMENT', defaultValue: false, description: '工艺耗材参数')
    booleanParam(name: 'TEST_PROCESS_OTHERS', defaultValue: false, description: '其他工艺参数')
    booleanParam(name: 'TEST_PRINTER', defaultValue: false, description: '打印机参数')
    booleanParam(name: 'TEST_FILAMENT', defaultValue: false, description: '耗材参数')
    string(name: 'PYTEST_EXTRA_ARGS', defaultValue: '', description: 'Optional advanced pytest arguments, for example: -k wall_loops --maxfail=1')
    string(name: 'ALLURE_CMD', defaultValue: 'Allure', description: 'Allure commandline tool name (Global Tool); leave empty to use default')
  }
  environment {
    PYTHONIOENCODING = 'utf-8'
    SKIP_TESTED_BUILD = 'true'
    ALLURE_RESULTS_DIR = 'allure-results-params'
  }
  stages {
    stage('Checkout') {
      steps { checkout scm }
    }
    stage('Select parameter tests') {
      steps {
        script {
          def selectedGroups = []
          if (params.TEST_QUALITY) {
            selectedGroups << [name: '质量', path: 'engine_params/case/params/process/quality']
          }
          if (params.TEST_STRENGTH) {
            selectedGroups << [name: '强度', path: 'engine_params/case/params/process/strength']
          }
          if (params.TEST_SUPPORT) {
            selectedGroups << [name: '支撑', path: 'engine_params/case/params/process/support']
          }
          if (params.TEST_SPEED) {
            selectedGroups << [name: '速度', path: 'engine_params/case/params/process/speed']
          }
          if (params.TEST_PROCESS_FILAMENT) {
            selectedGroups << [name: '工艺耗材', path: 'engine_params/case/params/process/filament']
          }
          if (params.TEST_PROCESS_OTHERS) {
            selectedGroups << [name: '其他工艺', path: 'engine_params/case/params/process/others']
          }
          if (params.TEST_PRINTER) {
            selectedGroups << [name: '打印机', path: 'engine_params/case/params/printer']
          }
          if (params.TEST_FILAMENT) {
            selectedGroups << [name: '耗材', path: 'engine_params/case/params/filament']
          }

          if (selectedGroups.isEmpty()) {
            error('At least one parameter test group must be selected.')
          }

          def commandParts = selectedGroups.collect { it.path }
          commandParts << '-m paramters'
          def extraArgs = params.PYTEST_EXTRA_ARGS?.trim()
          if (extraArgs) {
            commandParts << extraArgs
          }

          env.PARAM_TEST_COMMAND = commandParts.join(' ')
          def selectedNames = selectedGroups.collect { it.name }.join(', ')
          echo "Selected parameter test groups: ${selectedNames}"
          echo "Generated pytest selection: ${env.PARAM_TEST_COMMAND}"
          currentBuild.description = "参数测试：${selectedNames}"
        }
      }
    }
    stage('Install deps') {
      steps {
        bat '''
python -m pip install -U pip
python -m pip install -r requirements.txt
if exist allure-results-params rd /s /q allure-results-params
'''
      }
    }
    stage('Download artifact and run parameter tests') {
      steps {
        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
          withCredentials([sshUserPrivateKey(credentialsId: 'cxsw-ssh-key', keyFileVariable: 'SSH_KEY', usernameVariable: 'SSH_USER')]) {
            bat '''
@echo off
setlocal enabledelayedexpansion

if "%JOB_NAME%"=="" (
  echo JOB_NAME is required
  exit /b 1
)
if "%BUILD_ID%"=="" (
  echo BUILD_ID is required
  exit /b 1
)

set "EXTRA_ARGS="
if not "%ARTIFACT_PATH%"=="" set "EXTRA_ARGS=!EXTRA_ARGS! --artifact-path \"%ARTIFACT_PATH%\""
if not "%PLATFORM%"=="" set "EXTRA_ARGS=!EXTRA_ARGS! --platform \"%PLATFORM%\""
set "EXTRA_ARGS=!EXTRA_ARGS! --test-command \"%PARAM_TEST_COMMAND%\""

python ci\\jenkins_build_tester.py --job-name "%JOB_NAME%" --build-id "%BUILD_ID%" --artifacts-dir "%ARTIFACTS_DIR%" --allure-results-dir "%ALLURE_RESULTS_DIR%" --skip-tested-build --preserve-extracted-files !EXTRA_ARGS!
endlocal
'''
          }
        }
      }
    }
    stage('Allure parameter-test results') {
      steps {
        catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
          script {
            def allurePath = 'allure-results-params'
            if (fileExists(allurePath)) {
              echo "Publishing independent Allure results from ${allurePath}"
              def cmdName = params.ALLURE_CMD?.trim()
              if (cmdName) {
                allure includeProperties: false, jdk: '', commandline: cmdName, results: [[path: allurePath]]
              } else {
                allure includeProperties: false, jdk: '', results: [[path: allurePath]]
              }
            } else {
              echo 'No parameter-test Allure results found, skipping publish'
            }
          }
        }
      }
    }
    stage('Archive parameter-test artifacts') {
      steps {
        archiveArtifacts artifacts: 'allure-results-params/**,test_framework/engine_params/output/**,test_framework/artifacts/slicer_stdout*.log', allowEmptyArchive: true
      }
    }
  }
  post {
    failure {
      echo 'Parameter-test pipeline failed.'
    }
  }
}
