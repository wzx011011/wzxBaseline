pipeline {
  agent { label params.AGENT_LABEL }
  options {
    timestamps()
    disableConcurrentBuilds()
  }
  parameters {
    string(name: 'AGENT_LABEL', defaultValue: 'windows-tester1', description: 'Jenkins agent label to run the pipeline on')
    string(name: 'JOB_NAME', defaultValue: 'CrealityPrint_Release_Package_pipeline', description: 'Jenkins job name to download from')
    string(name: 'BUILD_ID', defaultValue: 'lastSuccessfulBuild', description: 'Jenkins build number or lastSuccessfulBuild')
    string(name: 'BASELINE_BUILD_ID', defaultValue: '1793', description: 'Fixed baseline build number for second-slice comparison')
    booleanParam(name: 'UPDATE_BASELINE', defaultValue: false, description: 'Allow updating the persistent second-slice baseline CSV')
    string(name: 'ARTIFACT_PATH', defaultValue: '', description: 'Artifact relativePath or filename (optional)')
    string(name: 'PLATFORM', defaultValue: 'windows', description: 'Platform label for env injection (windows/macos_x86/macos_arm64/linux)')
    string(name: 'TEST_COMMAND', defaultValue: 'performance/case/test_slice.py::test_feishu_slice -m performance', description: 'Override test command (optional)')
    string(name: 'ALLURE_CMD', defaultValue: 'Allure', description: 'Allure commandline tool name (Global Tool); leave empty to use default')
  }
  environment {
    POWERSHELL_HOME = "C:\\Windows\\System32\\WindowsPowerShell\\v1.0"
    PYTHONIOENCODING = 'utf-8'
    SLICER_DATADIR_ISOLATED = '1'
    SKIP_TESTED_BUILD = 'true'
  }
  stages {
    stage('Checkout') {
      steps { checkout scm }
    }
    stage('Install deps') {
      steps {
        bat '''
python -m pip install -U pip
python -m pip install -r requirements.txt
if exist allure-results rd /s /q allure-results
'''
      }
    }
    stage('Download artifact and run tests') {
      steps {
        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
          withCredentials([sshUserPrivateKey(credentialsId: 'cxsw-ssh-key', keyFileVariable: 'SSH_KEY', usernameVariable: 'SSH_USER')]) {
            bat '''
@echo off
setlocal enabledelayedexpansion

if "%JOB_NAME%"=="" (
  echo JOB_NAME is required
  exit /b 1
)
if "%BUILD_ID%"=="" (
  echo BUILD_ID is required
  exit /b 1
)

set "EXTRA_ARGS="
if not "%ARTIFACT_PATH%"=="" set "EXTRA_ARGS=!EXTRA_ARGS! --artifact-path \"%ARTIFACT_PATH%\""
if not "%PLATFORM%"=="" set "EXTRA_ARGS=!EXTRA_ARGS! --platform \"%PLATFORM%\""
if not "%TEST_COMMAND%"=="" set "EXTRA_ARGS=!EXTRA_ARGS! --test-command \"%TEST_COMMAND%\""
if not "%BASELINE_BUILD_ID%"=="" set "EXTRA_ARGS=!EXTRA_ARGS! --baseline-build-id \"%BASELINE_BUILD_ID%\""
if /I "%UPDATE_BASELINE%"=="true" set "EXTRA_ARGS=!EXTRA_ARGS! --update-baseline"

python ci\\jenkins_build_tester.py --job-name "%JOB_NAME%" --build-id "%BUILD_ID%" --artifacts-dir "%ARTIFACTS_DIR%" --skip-tested-build --preserve-extracted-files !EXTRA_ARGS!
endlocal
'''
          }
        }
      }
    }
    stage('Allure results') {
      steps {
        catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
          script {
            def allurePaths = ['allure-results', 'test_framework/allure-results', 'output/report/allure-results', 'test_engine_framework/output/report/allure-results']
            def found = allurePaths.find { fileExists(it) }
            if (found) {
              echo "Publishing Allure results from ${found}"
              def cmdName = params.ALLURE_CMD?.trim()
              if (cmdName) {
                allure includeProperties: false, jdk: '', commandline: cmdName, results: [[path: found]]
              } else {
                allure includeProperties: false, jdk: '', results: [[path: found]]
              }
            } else {
              echo 'No Allure results found, skipping publish'
            }
          }
        }
      }
    }
    stage('Archive performance reports') {
      steps {
        archiveArtifacts artifacts: 'test_framework/performance/data/*.csv,test_framework/performance/data/*.md,test_framework/performance/data/*.json,test_framework/artifacts/slicer_stdout*.log', allowEmptyArchive: true
      }
    }
  }
  post {
    always {
      withCredentials([string(credentialsId: 'openclaw-webhook', variable: 'FEISHU_WEBHOOK')]) {
        script {
          withEnv([
            "PACKAGE_JOB_NAME=${params.JOB_NAME ?: ''}",
            "PACKAGE_BUILD_ID=${params.BUILD_ID ?: ''}",
            "PERFORMANCE_JOB_NAME=${env.JOB_BASE_NAME ?: env.JOB_NAME}",
            "PIPELINE_RESULT=${currentBuild.currentResult ?: 'UNKNOWN'}"
          ]) {
            def notifyStatus = powershell(returnStatus: true, script: '''
if ([string]::IsNullOrWhiteSpace($env:FEISHU_WEBHOOK)) {
  Write-Warning "Feishu webhook is empty; skipping notification."
  exit 0
}

$performanceJob = $env:PERFORMANCE_JOB_NAME
$packageJob = $env:PACKAGE_JOB_NAME
$packageBuild = $env:PACKAGE_BUILD_ID
$summaryPath = "test_framework\\performance\\data\\second_slice_efficiency_summary.md"

$lines = New-Object "System.Collections.Generic.List[string]"
$lines.Add("C3DBaseline 二次切片性能结果")
$lines.Add("")
$lines.Add("打包构建：$packageJob #$packageBuild")
$lines.Add("性能构建：$performanceJob #$env:BUILD_NUMBER")
$lines.Add("结果：$env:PIPELINE_RESULT")
$lines.Add("链接：$env:BUILD_URL")

if (Test-Path $summaryPath) {
  $summary = (Get-Content $summaryPath -Raw -Encoding UTF8).Trim()
  if (-not [string]::IsNullOrWhiteSpace($summary)) {
    $lines.Add("")
    $lines.Add($summary)
  }
} else {
  $lines.Add("")
  $lines.Add("未找到二次切片效率总结文档：$summaryPath")
}

$text = ($lines -join [Environment]::NewLine)
if ($text.Length -gt 18000) {
  $text = $text.Substring(0, 18000) + [Environment]::NewLine + "...(truncated)"
}

$payload = @{
  msg_type = "text"
  content = @{
    text = $text
  }
} | ConvertTo-Json -Depth 6 -Compress
$body = [System.Text.Encoding]::UTF8.GetBytes($payload)

try {
  $hookUri = [Uri]$env:FEISHU_WEBHOOK
  Write-Host ("Feishu webhook host: " + $hookUri.Host)
} catch {
  Write-Warning "Feishu webhook URL is not a valid URI."
}

for ($attempt = 1; $attempt -le 3; $attempt++) {
  try {
    $response = Invoke-RestMethod `
      -Uri $env:FEISHU_WEBHOOK `
      -Method Post `
      -ContentType "application/json; charset=utf-8" `
      -Body $body `
      -TimeoutSec 30 `
      -ErrorAction Stop

    $responseJson = $response | ConvertTo-Json -Depth 6 -Compress
    if ($null -ne $response.code -and [int]$response.code -ne 0) {
      throw "Feishu returned code=$($response.code), msg=$($response.msg)"
    }
    Write-Host "Feishu notification sent on attempt ${attempt}: $responseJson"
    exit 0
  } catch {
    Write-Warning ("Feishu notification attempt $attempt failed: " + $_.Exception.Message)
    if ($attempt -lt 3) {
      Start-Sleep -Seconds (5 * $attempt)
    }
  }
}

Write-Warning "Feishu notification failed after 3 attempts."
exit 0
''')

            if (notifyStatus != 0) {
              echo "Feishu notification step exited with code ${notifyStatus}, but the pipeline result will be preserved."
            }
          }
        }
      }
    }
    failure {
      echo 'Pipeline failed; check Feishu notifications for details.'
    }
  }
}
