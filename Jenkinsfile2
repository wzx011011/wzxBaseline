pipeline {
  agent { label params.AGENT_LABEL }
  options {
    timestamps()
    disableConcurrentBuilds()
  }
  parameters {
    string(name: 'AGENT_LABEL', defaultValue: 'tester2', description: 'Jenkins agent label to run the pipeline on')
    string(name: 'JOB_NAME', defaultValue: 'CrealityPrint_Release_Package_pipeline', description: 'Jenkins job name to download from')
    string(name: 'BUILD_ID', defaultValue: 'lastSuccessfulBuild', description: 'Jenkins build number or lastSuccessfulBuild')
    string(name: 'BASELINE_BUILD_ID', defaultValue: '81', description: 'Fixed baseline build number for second-slice comparison')
    booleanParam(name: 'ENABLE_SECOND_SLICE', defaultValue: false, description: 'Run moved-model second-slice performance checks')
    string(name: 'IDLE_NO_SLICING_RETRIES', defaultValue: '1', description: '0 disables retry; any positive value retries current model once only for -1/no_slicing')
    string(name: 'LOAD_TIMEOUT_SECONDS', defaultValue: '300', description: 'Maximum time to import one 3MF model')
    string(name: 'PERFORMANCE_HISTORY_BUILDS', defaultValue: '50', description: 'Number of tester runs retained in the performance trend')
    string(name: 'PERFORMANCE_REGRESSION_PERCENT', defaultValue: '10', description: 'First-slice regression threshold in percent')
    string(name: 'PERFORMANCE_MIN_DELTA_MS', defaultValue: '2000', description: 'Minimum first-slice regression in milliseconds')
    string(name: 'ARTIFACT_PATH', defaultValue: '', description: 'Artifact relativePath or filename (optional)')
    string(name: 'PLATFORM', defaultValue: 'windows', description: 'Platform label for env injection (windows/macos_x86/macos_arm64/linux)')
    string(name: 'TEST_COMMAND', defaultValue: '-m "engine_params or performance"', description: 'Override test command (optional)')
    string(name: 'ALLURE_CMD', defaultValue: 'Allure', description: 'Allure commandline tool name (Global Tool); leave empty to use default')
  }
  environment {
    POWERSHELL_HOME = "C:\\Windows\\System32\\WindowsPowerShell\\v1.0"
    PYTHONIOENCODING = 'utf-8'
  }
  stages {
    stage('Checkout') {
      steps { checkout scm }
    }
    stage('Install deps') {
      steps {
        bat '''
python -m pip install -U pip
python -m pip install -r requirements.txt
if exist allure-results rd /s /q allure-results
'''
      }
    }
    stage('Download artifact and run tests') {
      steps {
        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
          withCredentials([sshUserPrivateKey(credentialsId: 'cxsw-ssh-key', keyFileVariable: 'SSH_KEY', usernameVariable: 'SSH_USER')]) {
            bat '''
@echo off
setlocal enabledelayedexpansion

if "%JOB_NAME%"=="" (
  echo JOB_NAME is required
  exit /b 1
)
if "%BUILD_ID%"=="" (
  echo BUILD_ID is required
  exit /b 1
)

set "EXTRA_ARGS="
set "SLICER_IDLE_NO_SLICING_RETRIES=%IDLE_NO_SLICING_RETRIES%"
set "SLICER_LOAD_TIMEOUT=%LOAD_TIMEOUT_SECONDS%"
set "SLICER_STDOUT_LOG=%WORKSPACE%/test_framework/artifacts/slicer_stdout.log"
set "CREALITY_PRINTER_LOG_PATH=%WORKSPACE%/test_framework/artifacts/creality_logs"
if not exist "%CREALITY_PRINTER_LOG_PATH%" mkdir "%CREALITY_PRINTER_LOG_PATH%"
if defined ARTIFACT_PATH set EXTRA_ARGS=!EXTRA_ARGS! --artifact-path "!ARTIFACT_PATH!"
if defined PLATFORM set EXTRA_ARGS=!EXTRA_ARGS! --platform "!PLATFORM!"
if defined TEST_COMMAND set EXTRA_ARGS=!EXTRA_ARGS! --test-command "!TEST_COMMAND!"
if defined BASELINE_BUILD_ID set EXTRA_ARGS=!EXTRA_ARGS! --baseline-build-id "!BASELINE_BUILD_ID!"
if /I "!ENABLE_SECOND_SLICE!"=="true" set "EXTRA_ARGS=!EXTRA_ARGS! --enable-second-slice"

python ci\\jenkins_build_tester.py --job-name "%JOB_NAME%" --build-id "%BUILD_ID%" --artifacts-dir "%ARTIFACTS_DIR%" --preserve-extracted-files !EXTRA_ARGS!
endlocal
'''
          }
        }
      }
    }
    stage('Allure results') {
      steps {
        catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
          script {
            def allurePaths = ['allure-results', 'test_framework/allure-results', 'output/report/allure-results', 'test_engine_framework/output/report/allure-results']
            def found = allurePaths.find { fileExists(it) }
            if (found) {
              echo "Publishing Allure results from ${found}"
              def cmdName = params.ALLURE_CMD?.trim()
              if (cmdName) {
                allure includeProperties: false, jdk: '', commandline: cmdName, results: [[path: found]]
              } else {
                allure includeProperties: false, jdk: '', results: [[path: found]]
              }
            } else {
              echo 'No Allure results found, skipping publish'
            }
          }
        }
      }
    }
    stage('Archive performance reports') {
      steps {
        archiveArtifacts artifacts: 'test_framework/performance/data/*.csv,test_framework/performance/data/*.md,test_framework/performance/data/*.json,test_framework/performance/data/*.html,test_framework/performance/data/performance_charts/*.svg,test_framework/artifacts/slicer_stdout.log,test_framework/artifacts/creality_logs/**/*', allowEmptyArchive: true
      }
    }
  }
  post {
    failure {
      echo 'Pipeline failed; check the console output for details.'
    }
  }
}
